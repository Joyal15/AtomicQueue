# QueueLess++ Environment Variables

# Backend
PORT=4000
NODE_ENV=development

# Database
MONGODB_URI=

# Redis / Upstash
REDIS_URL=

# Authentication — Redis-backed opaque sessions (HttpOnly cookie), not JWT
SESSION_COOKIE_SECRET=
SESSION_TTL_SECONDS=604800
MAGIC_LINK_TTL_SECONDS=3600

# CORS origin for the frontend dev server (local dev only — production is single-origin,
# architecture doc Section 14, so this only matters while frontend/backend run as two
# separate dev processes)
FRONTEND_URL=http://localhost:5173

# AI — no-show risk scoring (architecture doc §10). Leave GEMINI_API_KEY unset to
# disable scoring entirely: the job no-ops silently and noShowRiskNote stays null.
GEMINI_API_KEY=
# Optional — defaults to gemini-1.5-flash
GEMINI_MODEL=gemini-1.5-flash

# Email (Resend) — leave both unset in local dev to use the console-log stub sender
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Frontend calls the API via relative /api/... paths (see apps/web/src/lib/api.ts and
# apps/web/vite.config.ts's dev proxy) — no frontend-side API base-URL variable is needed.